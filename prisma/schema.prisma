// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid(7))
  username String
  passwordHash String
  createdAt DateTime @default(now())
  globalPermissionId String?
  dateOfBirth DateTime

  sessions Session[]
  chats ChatUser[]
  messages Message[]
  ownedChats Chat[]
  globalPermission GlobalPermission? @relation(fields: [globalPermissionId], references: [id])

  @@unique([username])
}

model GlobalPermission {
  id String @id @default(uuid(7))
  name String
  value Int @default(0)
  defaultChatPermissionId String

  users User[]

  defaultChatPermission ChatPermission @relation(fields: [defaultChatPermissionId], references: [id])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime

  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
}

model Character {
  id String @id @default(uuid(7))
  acronym String?
  name String
  color String
  quote String @default("some random text for previewing purposes")
  quirk String @default("{}")
  chatUsers ChatUser[]
}

model Tag {
  id String @id @default(uuid(7))
  name String
  type String
  polarity String
}

model Chat {
  id String @id @default(uuid(7))
  url String
  ownerId String
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])
  chatUsers ChatUser[]
  messages Message[]
  permissions ChatPermission[]

  @@unique([url])
}

model ChatUser {
  id String @id @default(uuid(7))
  
  chatId String
  userId String
  characterId String
  permissionId String
  number Int
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id])
  permission ChatPermission @relation(fields: [permissionId], references: [id])

  @@unique([chatId, userId])
  @@unique([chatId, number])
  @@index([chatId, userId])
  @@index([chatId, number])
}

model ChatPermission {
  id String @id @default(uuid(7))
  name String
  value Int @default(0)
  system Boolean @default(false)
  
  chatUsers ChatUser[]
  chat Chat[]
  globalPermissions GlobalPermission[]
}

model Message {
  id String @id @default(uuid(7))
  chatId String
  userId String
  content String
  originalContent String
  createdAt DateTime
  modifiedAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}